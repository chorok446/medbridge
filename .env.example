# MedBridge 데스크톱 개발 설정 — 실사용자는 이 파일을 만질 필요가 없다.
# (실제 앱에서는 Tauri가 모든 값을 자동 주입한다)

APP_ENV=development

# 앱 데이터 루트 (미설정 시 OS 앱 데이터 경로: macOS ~/Library/Application Support/MedBridge,
# Windows %LOCALAPPDATA%\MedBridge). Tauri가 실행 시 주입한다.
#MEDBRIDGE_APP_DATA_DIR=

# 로컬 API 보호 토큰 (Tauri가 생성·주입; 개발 브라우저 테스트 시엔 비워둔다)
#MEDBRIDGE_API_TOKEN=

# 테스트·개발용 DB override (기본: 앱 데이터 디렉터리의 medbridge.db)
#DATABASE_URL=

MAX_PDF_SIZE_MB=50

# 프론트엔드 개발 서버 (pnpm dev)에서 sidecar 주소
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765
