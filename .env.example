# === 앱 공통 ===
APP_ENV=development
# single_user: 로컬 설치형(기본) — 아래 LOCAL_USER_* 사용자로 자동 인증
# multi_user: 세션 인증 모드 (SECRET_KEY 필수)
APP_MODE=single_user

# === 단일 사용자 모드 ===
LOCAL_USER_EMAIL=user@example.com
LOCAL_USER_DISPLAY_NAME=MedBridge User

# === multi_user 모드 전용 (single_user에서는 비워둬도 됨) ===
# 32자 이상. 세션 서명에 사용.
#SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# === 데이터베이스 ===
# 호스트에서 직접 실행할 때. Docker Compose 내부에서는 compose가 덮어쓴다.
DATABASE_URL=postgresql+asyncpg://medbridge:medbridge@localhost:5432/medbridge

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === 객체 저장소 (MinIO / S3 호환) ===
# MINIO_ENDPOINT: API·worker가 접근하는 주소 (compose 내부에서는 http://minio:9000)
MINIO_ENDPOINT=http://localhost:9000
# MINIO_PUBLIC_ENDPOINT: 브라우저가 presigned URL로 접근하는 주소
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=medbridge
MINIO_SECRET_KEY=medbridge-secret
MINIO_BUCKET_ORIGINALS=medbridge-originals
MINIO_BUCKET_REDACTED=medbridge-redacted
MINIO_BUCKET_DERIVED=medbridge-derived
MINIO_TIMEOUT_SECONDS=10

# === 업로드 제한 ===
MAX_PDF_SIZE_MB=50
PRESIGN_EXPIRY_SECONDS=300

# === 프론트엔드 (apps/web) ===
# Next.js 서버가 프록시할 API 내부 주소
API_INTERNAL_URL=http://localhost:8000
# 클라이언트 표시용 최대 업로드 크기 (MB)
NEXT_PUBLIC_MAX_UPLOAD_MB=50
