{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedBridge Study",
  "version": "0.1.0",
  "identifier": "com.medbridge.study",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --dir ../web dev",
    "beforeBuildCommand": "pnpm --dir ../web build"
  },
  "app": {
    "windows": [
      {
        "title": "MedBridge Study",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["resources/ocr"],
    "externalBin": ["binaries/medbridge-sidecar"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "TAURI_UPDATER_PUBLIC_KEY_PLACEHOLDER",
      "endpoints": [
        "https://github.com/chorok446/medbridge-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
