# Node
node_modules/
.next/
out/
coverage/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/

# Env / secrets — 실사용자 설정이 git pull로 덮어써지지 않도록 example만 추적한다
.env
.env.local
.env.production
.env.pilot
.env.*.local

# OS / editor
.DS_Store

# Build / test artifacts
dist/
playwright-report/
test-results/
artifacts/

# Local data (never bind-mount DB data on external SSD; named volumes only)
.data/

# Rust / Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/resources/ocr/

# Windows 실기기 검증 테스트 PDF (재생성 가능, git 미추적)
docs/testing/windows-test-kit/*.pdf

# 로컬 에이전트 도구 설정 (개발자 머신마다 다름)
.claude/
# `npx skills add`가 설치하는 서드파티 스킬과 잠금 파일. .claude/와 같은 부류로,
# 제품 코드가 아니라 개발자 머신의 도구 설정이다. 무시하지 않으면 `git add .` 한 번에
# 스킬 저장소 수십~수백 파일이 제품 저장소로 딸려 들어온다.
.agents/
skills-lock.json

# 임시 작업 산출물 (스모크 테스트 PDF/이미지 등, 재생성 가능)
tmp/

# CI가 만드는 중간 산출물 (잠금 파일·테스트에서 매번 재생성)
requirements-audit.txt
audit.log
pipaudit.log
pytest.log
vitest.log
